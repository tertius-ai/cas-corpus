{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tertius-ai/cas-corpus/schemas/case.schema.json",
  "title": "CAS Corpus case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "domains",
    "source",
    "translation",
    "noether",
    "execution"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["linalg", "numthy", "commalg", "groups", "topology", "homalg", "combin", "geometry", "category"]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "citation", "url", "license", "redistribution"],
      "properties": {
        "intake_id": { "type": ["string", "null"] },
        "kind": { "enum": ["paper", "notebook", "book", "documentation", "repository", "original"] },
        "citation": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] },
        "license": { "type": "string", "minLength": 1 },
        "redistribution": { "enum": ["citation-only", "licensed-copy", "original"] },
        "retrieved_at": { "type": ["string", "null"], "format": "date" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "notes"],
      "properties": {
        "kind": { "enum": ["translation", "adaptation", "original"] },
        "notes": { "type": "string" }
      }
    },
    "noether": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "operations"],
      "properties": {
        "version": { "const": "0.3.2" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]*$" }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "timeout_seconds", "seed"],
      "properties": {
        "entrypoint": { "const": "solution.py" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "seed": { "type": ["integer", "null"] }
      }
    }
  }
}
